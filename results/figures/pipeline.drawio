<mxfile host="app.diagrams.net"><diagram name="Pipeline" id="pipeline"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rec" value='&lt;p style="margin:0 0 10px 0"&gt;&lt;b&gt;1&amp;nbsp; Recording&lt;/b&gt;&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;Helmet-mounted Insta360 X3&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;68 sessions, ≈17.5 h&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;Helsinki, London, Las Palmas&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;video 30 fps, GPS 1 Hz&lt;/p&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontColor=#52514E;strokeColor=#898781;fillColor=#F1F0EC;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="180" height="240" as="geometry"/></mxCell><mxCell id="lab" value='&lt;p style="margin:0 0 10px 0"&gt;&lt;b&gt;2&amp;nbsp; Event labelling&lt;/b&gt;&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;OSM intersection nodes&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;crossing: entry into 15 m radius&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;stop: stationary ≥3 s&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;otherwise heading change ±30°: left / right / straight&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;manual review&lt;/p&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontColor=#52514E;strokeColor=#898781;fillColor=#E3EEFB;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="180" height="240" as="geometry"/></mxCell><mxCell id="clip" value='&lt;p style="margin:0 0 10px 0"&gt;&lt;b&gt;3&amp;nbsp; Clip extraction&lt;/b&gt;&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;4 s window ending at crossing&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;32 frames, 256 × 256&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;session-level split: 58 train / 10 val sessions&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;6,285 labelled clips&lt;/p&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontColor=#52514E;strokeColor=#898781;fillColor=#F1F0EC;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="180" height="240" as="geometry"/></mxCell><mxCell id="enc" value='&lt;p style="margin:0 0 10px 0"&gt;&lt;b&gt;4&amp;nbsp; Feature encoding&lt;/b&gt;&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;V-JEPA 2 ViT-g/16 (frozen)&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;4096 × 1408 tokens per clip&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;optional predictor: +256 tokens at τ = 1 s&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;training-set flip: left ↔ right&lt;/p&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontColor=#52514E;strokeColor=#898781;fillColor=#FDE7DC;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="180" height="240" as="geometry"/></mxCell><mxCell id="probe" value='&lt;p style="margin:0 0 10px 0"&gt;&lt;b&gt;5&amp;nbsp; Probe training&lt;/b&gt;&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;linear, MLP, Attn-1, Attn-4&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;weighted cross-entropy&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;output: left, right, straight, stop&lt;/p&gt;&lt;p style="margin:0 0 7px 0"&gt;best epoch by macro accuracy&lt;/p&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontColor=#52514E;strokeColor=#898781;fillColor=#DDF3EA;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="180" height="240" as="geometry"/></mxCell><mxCell id="e1" value="GPS" style="html=1;endArrow=block;endFill=1;strokeColor=#898781;strokeWidth=1.5;fontSize=11;fontColor=#52514E;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="video 30 fps" style="html=1;endArrow=block;endFill=1;strokeColor=#898781;strokeWidth=1.5;fontSize=11;fontColor=#52514E;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="clip"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110.0" y="320"/><mxPoint x="570.0" y="320"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#898781;strokeWidth=1.5;fontSize=11;fontColor=#52514E;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="clip"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#898781;strokeWidth=1.5;fontSize=11;fontColor=#52514E;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="clip" target="enc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#898781;strokeWidth=1.5;fontSize=11;fontColor=#52514E;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="enc" target="probe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw0" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FDE7DC;strokeColor=#898781;" vertex="1" parent="1"><mxGeometry x="710" y="355" width="16" height="16" as="geometry"/></mxCell><mxCell id="lt0" value="Pretrained, frozen" style="text;html=1;align=left;verticalAlign=middle;fontSiz